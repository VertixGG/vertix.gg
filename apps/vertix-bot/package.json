{
    "name": "@vertix.gg/bot",
    "version": "0.0.53",
    "license": "MIT",
    "author": "Leonid Vinikov <leonidvinikov@gmail.com>",
    "main": "index.ts",
    "bin": "dist/index.min.js",
    "type": "module",
    "scripts": {
        "vertix-bot:jest": "LOGGER_DISABLED=true @z-jest --selectedProjects bot",
        "vertix-bot:typecheck": "bunx --bun tsc --noEmit",
        "vertix-bot:build": "scripts/build.sh",
        "vertix-bot:release": "scripts/build.sh --update-package-version && bash ./scripts/release.sh",
        "vertix-bot:watch:dev": "bun run @z-cli @watch --dev",
        "vertix-bot:node:start": "node dist/vertix-bot.mjs",
        "vertix-bot:bun:start:dev": "bunx dotenv-cli -e ../../.env -- bun src/index-bun.ts",
        "vertix-bot:bun:start:dev--debug": "bun --inspect src/index-bun.ts",
        "vertix-bot:ts-node:start:dev": "bunx dotenv-cli -e ../../.env -- tsx --tsconfig tsconfig.es.dev.json --trace-exit --trace-uncaught --enable-source-maps src/index.ts",
        "vertix-bot:ts-node:start:dev--debug": "NODE_OPTIONS='--max-old-space-size=226' ts-node src/index.ts"
    },
    "dependencies": {
        "@discordjs/rest": "^2.6.3",
        "@napi-rs/canvas": "^1.0.9",
        "@top-gg/sdk": "^3.1.6",
        "@vertix.gg/base": "workspace:*",
        "@vertix.gg/data": "workspace:*",
        "@vertix.gg/definitions": "workspace:*",
        "@vertix.gg/gui": "workspace:*",
        "@vertix.gg/prisma": "workspace:*",
        "@vertix.gg/utils": "workspace:*",
        "@zenflux/utils": "latest",
        "cross-fetch": "^3.1.5",
        "discord-api-types": "latest",
        "discord.js": "latest",
        "dotenv": "^16.0.3",
        "jest-diff": "^30.5.1",
        "picocolors": "^1.0.1",
        "tough-cookie": "^6.0.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.1",
        "@vertix.gg/test-utils": "workspace:*",
        "@zenflux/cli": "latest",
        "@zenflux/tsconfig-to-swc": "0.1.21",
        "jest": "latest"
    }
}
