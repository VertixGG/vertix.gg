# =============================================================================
# Vertix - Example environment file
# =============================================================================
# Copy this file to `.env` and fill in the placeholder values.
#
#   cp example.env .env
#
# Every Vertix service (bot, api, dashboard, mcp, logger) reads from this
# single root-level `.env` file. Do NOT commit your real `.env` — it is
# gitignored. Only `example.env` is checked in.
# =============================================================================


###############
### GENERAL ###
###############

# DEV or PROD. In DEV the bot skips the startup cleanup worker, so local
# channels survive a restart.
ENV_MODE=DEV


###############
### DISCORD ###
###############

# Your Discord user id (the bot owner). Right-click your Discord profile →
# "Copy User ID" (Developer Mode must be enabled).
OWNERD_ID=""

# Discord bot token from https://discord.com/developers/applications
# → "Bot" tab → "Reset Token". This is the one the bot, the api and the
# headless emoji fetch log in with.
DISCORD_BOT_TOKEN=""

# The token vertix-mcp acts as. It is also the fallback everywhere above, so a
# single-bot setup can fill either one and leave the other empty.
DISCORD_MCP_TOKEN=""

# Set to true to make the bot respond when mentioned (legacy mention handler).
ENABLE_MENTION_HANDLER=true

# Paddle, which is how plans are sold.
#
# Discord sells guild subscriptions itself and that is what this was built
# against - but Premium Apps are sold from the US, the EU and the UK only, so
# it is not available to us. Paddle is a merchant of record: it sells to the
# customer, collects the sales tax and pays out.
#
# The price ids come from the paddle dashboard, and a price belongs to one
# paddle account - the sandbox is a different account from the live one, which
# is why these are environment rather than code. How many generators each one
# allows is in `billing-definitions.ts`.
#
# Leave a tier empty and it is simply not sold, and every server stays on what
# it was granted.
PADDLE_PRICE_PLUS=""
PADDLE_PRICE_PRO=""
PADDLE_PRICE_ULTIMATE=""

# The secret for the notification destination that sends the webhook, from
# paddle's dashboard under Developer Tools -> Notifications.
#
# Read by the api, which is what paddle talks to. Without it the webhook
# answers 503 rather than trusting anything: unsigned, there is no telling a
# real subscription from somebody who found the url.
PADDLE_WEBHOOK_SECRET=""

# Paddle's client-side half, which the dashboard is built with.
#
# The client token is meant to be public - it is what paddle's own script
# authenticates with in the browser - and the price ids above are not secret
# either. The api key, which is, is not used anywhere here.
#
# `sandbox` until a deployment says otherwise, so a half-configured one cannot
# take real money by accident.
PADDLE_CLIENT_TOKEN=""
PADDLE_ENVIRONMENT="sandbox"

################
### DATABASE ###
################

# MongoDB must run as a replica set (Prisma requirement).
# Local replica set:
BOT_PRISMA_DATABASE_URL="mongodb://127.0.0.1:27017/discord?directConnection=true"
API_PRISMA_DATABASE_URL="mongodb://127.0.0.1:27017/api?directConnection=true"

# Only needed to run apps/vertix-ai - it has a schema of its own.
VERTIX_AI_PRISMA_DATABASE_URL="mongodb://127.0.0.1:27017/vertix-ai?directConnection=true"

# MongoDB Atlas alternative (uncomment + replace placeholders):
#BOT_PRISMA_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/discord"
#API_PRISMA_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/api"
#VERTIX_AI_PRISMA_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vertix-ai"


#############
### REDIS ###
#############

# How the bot and the api talk to each other - editing a generator in the
# dashboard reaches the channels already open over this. Both processes must
# point at the same instance.
REDIS_URL="redis://localhost:6379"

# Signs every message on that bus. Anything arriving unsigned, altered, or more
# than a minute old is refused, so reaching Redis is no longer enough to drive
# the bot - a delete has to come from a process holding this value.
# The same value must be set for vertix-bot, vertix-api and vertix-mcp.
# Generate one with: openssl rand -hex 32
IPC_SHARED_SECRET=""


#################
### DASHBOARD ###
#################

DASHBOARD_PORT=3020
DASHBOARD_HOST=0.0.0.0

# Production dashboard URL (only used in production builds).
DASHBOARD_PROD_URL=https://dashboard.voicechannels.online

# Where the dashboard is served from, as the api sees it - the cors origin it
# allows and the address it sends a user back to after discord oauth. Defaults
# to http://localhost:3020.
DASHBOARD_URL=http://localhost:3020

# Discord OAuth2 application credentials. Create an application in the Discord
# Developer Portal, then under "OAuth2" copy the Client ID and Client Secret.
DASHBOARD_DISCORD_CLIENT_ID=""
DASHBOARD_DISCORD_CLIENT_SECRET=""

# Add this redirect URI to your Discord OAuth2 application settings.
DASHBOARD_DISCORD_REDIRECT_URI=http://localhost:3021/api/auth/discord/callback

# Random base64 string used to sign session cookies. Generate with:
#   openssl rand -base64 32
DASHBOARD_SESSION_SECRET=""


###########
### API ###
###########

# Where the api can be reached from outside, including the /api prefix. The site and the dashboard
# read it in the browser, and discord fetches embed images from its own side, so it has to be a url
# the public internet can resolve. Left empty it falls back to API_HOST:API_PORT.
API_PUBLIC_URL=

API_PORT=80
API_HOST=0.0.0.0


###############
### DEPLOYS ###
###############
# Optional - only needed if you use the included deploy scripts. Leave empty
# locally.

WEBSITE_DEPLOY_HOST=""
WEBSITE_DEPLOY_PORT=""
WEBSITE_DEPLOY_USERNAME=""
WEBSITE_DEPLOY_PASSWORD=""
WEBSITE_DEPLOY_PATH=""
WEBSITE_DEPLOY_KEY=""

DASHBOARD_DEPLOY_HOST=""
DASHBOARD_DEPLOY_PORT=""
DASHBOARD_DEPLOY_USERNAME=""
DASHBOARD_DEPLOY_PASSWORD=""
DASHBOARD_DEPLOY_PATH=""
DASHBOARD_DEPLOY_KEY=""


##############
### LOGGER ###
##############

LOGGER_SERVER_HTTP_HOST=127.0.0.1
LOGGER_SERVER_HTTP_PORT=3090

# Log levels:
#   0 - NONE   1 - ERROR   2 - WARNING   3 - ADMIN   4 - INFO   5 - LOG   6 - DEBUG
LOGGER_LOG_LEVEL=6

# "true" disables logger output entirely. Leave "false" for development.
LOGGER_DISABLED="false"
LOGGER_LOG_PREVIOUS_CALLER_SOURCE_DISABLED="false"


############################
### AI ASSISTANT CHANNEL ###
############################
# Optional - only needed if you use Vertix's AI assistant feature. The bot will
# listen in the configured guild/channel and respond through the local Codex or
# Claude Code CLI.

#AI_CHAT_DISCORD_TOKEN=""
#AI_CHAT_GUILD_ID=""
#AI_CHAT_CHANNEL_ID=""

# Path from `which codex`.
AI_CHAT_CODEX_BIN=""
AI_CHAT_PROVIDER="codex"
# Defaults to the lowest-usage ChatGPT Codex model when empty.
AI_CHAT_MODEL="gpt-5.6-luna"
# Read only when AI_CHAT_MODEL is empty - the same setting under its older name.
#OPENAI_CHAT_MODEL=""
AI_CHAT_PUBLIC_MODEL=""
AI_CHAT_PRIVATE_MODEL=""
AI_CHAT_REASONING_EFFORT="low"
# Local free mode requires Ollama or LM Studio and a downloaded model.
AI_CHAT_CODEX_OSS="false"
AI_CHAT_CODEX_LOCAL_PROVIDER="ollama"
AI_CHAT_CODEX_OSS_MODEL="gpt-oss:20b"
# DeepSeek cloud mode. Set AI_CHAT_PROVIDER="deepseek" to use it.
AI_CHAT_DEEPSEEK_API_KEY=""
AI_CHAT_DEEPSEEK_BASE_URL="https://api.deepseek.com"
AI_CHAT_DEEPSEEK_MODEL="deepseek-v4-flash"
AI_CHAT_DEEPSEEK_THINKING="false"
# Claude Code mode (works with a Claude Pro/Max subscription, no API key needed -
# sign in once with `claude` / `claude auth`). Set AI_CHAT_PROVIDER="claude" to use it.
# Path from `which claude`.
AI_CHAT_CLAUDE_BIN=""
# Alias (opus/sonnet/haiku) or full model name.
AI_CHAT_CLAUDE_MODEL="sonnet"
# Read-only tool set; anything else would need an interactive permission prompt.
AI_CHAT_CLAUDE_TOOLS="Read,Grep,Glob"
# Discord MCP server (apps/vertix-mcp) - lets the model act in Discord. On by default.
AI_CHAT_CLAUDE_MCP="true"
# Pre-approved MCP tools; without this Claude would ask for permission and never get an answer.
AI_CHAT_CLAUDE_MCP_ALLOWED_TOOLS="mcp__vertix-mcp"
# Optional - raw JSON or a path to a JSON file, replacing the generated MCP config.
AI_CHAT_CLAUDE_MCP_CONFIG=""
# Command used to launch apps/vertix-mcp.
AI_CHAT_MCP_COMMAND="bun"
# vertix-mcp acts as whatever bot it is handed in DISCORD_MCP_TOKEN; set it to the same
# value as AI_CHAT_DISCORD_TOKEN so its tools act as the AI Chat bot. Read-only vs full
# access is decided by VERTIX_MCP_READONLY, not by which token is set.

# The instructions the private assistant runs with. Required for the private handler - without
# it the AI channel stays silent. Multi-line values must stay inside the double quotes.
AI_CHAT_PRIVATE_SYSTEM_PROMPT="You are Vertix, a powerful Discord bot with FULL ACCESS to Discord operations. You are responding in a private admin channel.

You have access to the vertix-mcp tools with FULL permissions:
- You CAN read all guild info, channels, members, messages, roles, voice states
- You CAN send messages, DMs, and reactions
- You CAN create, edit, and delete channels
- You CAN kick, ban, and timeout users
- You CAN manage roles and permissions
- You CAN modify guild settings
- You CAN manage webhooks and invites

TALK THROUGH A GUI BY DEFAULT. You are a Discord bot, not a chat window - your normal way of
answering is an interactive message, not a paragraph:
- Build one with ui_create_adapter and pass the channelId from the Context block below, so it is posted
  right where you are replying. An embed carries what you want to say; buttons and a select menu
  carry what the user can do next
- Ask every question as buttons instead of in prose - one button per option. Offer choices,
  confirmations, next steps and statuses the same way
- Give each button and select option a short 'reply' text - it is only the instant acknowledgement
  the clicker sees. Every click is then handed back to you as a [UI interaction] message, so that
  is where you actually do the work and answer with an updated panel
- ui_get_interactions is there when you need the history of what was clicked
- One channel holds one panel. Whatever you name the UI, posting it into a channel that already
  has your panel rewrites that same message, so the user navigates screens in place, like an app
- A new message from the user starts a new panel, posted where they are looking instead of into the
  message above. A click keeps answering inside the panel it was clicked on, wherever that is
- When VoiceChannels already has a dialog for what you need, find it with ui_search / ui_get_adapter and
  post that one with ui_send_adapter (or ui_send_adapter_to_user to DM it) - a real adapter always
  beats a hand-built embed
- When you answer with a panel, return NO text at all - the panel is the message, and anything you
  write next to it is a second message repeating what the user can already see
- Plain text is the exception, for a short factual answer where there is genuinely nothing to
  click, and for the errors you have to explain

You also have access to the Vertix codebase and can help with development tasks.

Be helpful, precise, and execute commands when requested. This is an admin-only channel with full trust."


#################
### VERTIX AI ###
#################
# Optional - only needed to run apps/vertix-ai, which is a separate bot to the
# one above with a Discord application of its own. It answers through a local
# Ollama rather than through a CLI, so nothing here is shared with the
# AI ASSISTANT CHANNEL block.

# Required by the app - it refuses to start without one.
VERTIX_AI_DISCORD_TOKEN=""

# Register slash commands to this one guild instead of globally. Global
# commands can take an hour to reach clients; guild-scoped ones are immediate.
# Leave empty in production.
VERTIX_AI_DEV_GUILD_ID=""

# GuildMembers is a privileged intent - requesting it while it is switched off
# in the Developer Portal makes login fail outright, so it stays opt-in.
VERTIX_AI_ENABLE_MEMBER_INTENT="false"

# The Ollama instance to answer through, and the model it runs.
VERTIX_AI_OLLAMA_BASE_URL="http://localhost:11434"
VERTIX_AI_OLLAMA_MODEL="qwen3.5:35b-a3b-int4"

# Context window. Ollama's own default of 4096 silently truncates the tool
# schemas rather than failing, so this is always sent explicitly.
VERTIX_AI_OLLAMA_NUM_CTX=32768

# How long Ollama keeps the model resident between messages.
VERTIX_AI_OLLAMA_KEEP_ALIVE="30m"

# Generation is slow on a local model; this is the ceiling, in milliseconds.
VERTIX_AI_OLLAMA_REQUEST_TIMEOUT_MS=600000


########################
### TIMERS / CLEANUP ###
########################

# Guild(s) that every cleanup routine must leave alone - the cleanup worker,
# the scaling excess-channel cleanup and every master channel delete skip them.
# Comma-separated for more than one. Leave empty in production.
DEV_GUILD_ID=""

# Adapter cleanup intervals (milliseconds).
ADAPTER_CLEANUP_TIMER_INTERVAL=300000
ADAPTER_CLEANUP_EPHEMERAL_TIMEOUT=600000
ADAPTER_CLEANUP_STATIC_ARGS_TIMEOUT=600000

# How long somebody who has been handed the feedback screen is left alone before
# the bot answers them with it again (milliseconds).
#
# The feedback screen is the bot's answer to a direct message, and it should not be
# the answer to every line somebody types in a row. Long enough to answer a
# conversation once, short enough that coming back tomorrow is answered at all.
DIRECT_MESSAGE_FEEDBACK_COOLDOWN=86400000

# Dynamic Channel Vote and Claim managers.
#
# All but VOTE_TIMER_INTERVAL are defaults a guild can override for itself, through the `/setup`
# screen's `Server Options` -> `Edit Claim` button; a field left empty there puts that timing back
# on the value below. Milliseconds here, seconds in the interface. A guild cannot choose outside
# these ranges, and neither can these:
#   VOTE_TIMEOUT, VOTE_ADD_TIME                  5s - 24h
#   CLAIM_OWNERSHIP_TIMEOUT                      30s - 24h
#   CLAIM_OWNERSHIP_TIMER_INTERVAL               10s - 24h
# A value outside its range is ignored and the built in default is used instead.
#
# VOTE_TIMER_INTERVAL (1s - 24h) is not offered to guilds: every tick of it edits the running vote
# message, so it is Discord traffic rather than behaviour, and belongs with whoever runs the bot.
DYNAMIC_CHANNEL_VOTE_TIMEOUT=60000
DYNAMIC_CHANNEL_VOTE_ADD_TIME=60000
DYNAMIC_CHANNEL_VOTE_TIMER_INTERVAL=1000

DYNAMIC_CHANNEL_CLAIM_OWNERSHIP_TIMEOUT=600000
DYNAMIC_CHANNEL_CLAIM_OWNERSHIP_TIMER_INTERVAL=60000


##############
### TOP.GG ###
##############
# Optional - only needed if you list your bot on top.gg.

TOP_GG_VOTE_URL="https://top.gg/"
#TOP_GG_TOKEN=""


