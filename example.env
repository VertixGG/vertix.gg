# =============================================================================
# Vertix - Example environment file
# =============================================================================
# Copy this file to `.env` and fill in the placeholder values.
#
#   cp example.env .env
#
# Every Vertix service (bot, api, dashboard, mcp, logger) reads from this
# single root-level `.env` file. Do NOT commit your real `.env` — it is
# gitignored. Only `example.env` is checked in.
# =============================================================================


###############
### DISCORD ###
###############

# Your Discord user id (the bot owner). Right-click your Discord profile →
# "Copy User ID" (Developer Mode must be enabled).
OWNERD_ID=""

# Discord bot token from https://discord.com/developers/applications
# → "Bot" tab → "Reset Token".
DISCORD_TEST_TOKEN=""

# Set to true to make the bot respond when mentioned (legacy mention handler).
ENABLE_MENTION_HANDLER=true


################
### DATABASE ###
################

# MongoDB must run as a replica set (Prisma requirement).
# Local replica set:
BOT_PRISMA_DATABASE_URL="mongodb://127.0.0.1:27017/discord?directConnection=true"
API_PRISMA_DATABASE_URL="mongodb://127.0.0.1:27017/api?directConnection=true"

# MongoDB Atlas alternative (uncomment + replace placeholders):
#BOT_PRISMA_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/discord"
#API_PRISMA_DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/api"


#################
### DASHBOARD ###
#################

DASHBOARD_PORT=3020
DASHBOARD_HOST=0.0.0.0

# Production dashboard URL (only used in production builds).
DASHBOARD_PROD_URL=https://dashboard.vertix.gg

# Discord OAuth2 application credentials. Create an application in the Discord
# Developer Portal, then under "OAuth2" copy the Client ID and Client Secret.
DASHBOARD_DISCORD_CLIENT_ID=""
DASHBOARD_DISCORD_CLIENT_SECRET=""

# Add this redirect URI to your Discord OAuth2 application settings.
DASHBOARD_DISCORD_REDIRECT_URI=http://localhost:3021/api/auth/discord/callback

# Random base64 string used to sign session cookies. Generate with:
#   openssl rand -base64 32
DASHBOARD_SESSION_SECRET=""


###########
### API ###
###########

API_PORT=3021
API_HOST=0.0.0.0

# Production values (used during deploy).
API_PORT_PROD=80
API_HOST_PROD=https://vertix-api.example.com


###############
### DEPLOYS ###
###############
# Optional - only needed if you use the included deploy scripts. Leave empty
# locally.

WEBSITE_DEPLOY_HOST=""
WEBSITE_DEPLOY_PORT=""
WEBSITE_DEPLOY_USERNAME=""
WEBSITE_DEPLOY_PASSWORD=""
WEBSITE_DEPLOY_PATH=""
WEBSITE_DEPLOY_KEY=""

DASHBOARD_DEPLOY_HOST=""
DASHBOARD_DEPLOY_PORT=""
DASHBOARD_DEPLOY_USERNAME=""
DASHBOARD_DEPLOY_PASSWORD=""
DASHBOARD_DEPLOY_PATH=""
DASHBOARD_DEPLOY_KEY=""


##############
### LOGGER ###
##############

LOGGER_SERVER_HTTP_HOST=127.0.0.1
LOGGER_SERVER_HTTP_PORT=3090

# Log levels:
#   0 - NONE   1 - ERROR   2 - WARNING   3 - ADMIN   4 - INFO   5 - LOG   6 - DEBUG
LOGGER_LOG_LEVEL=6

# "true" disables logger output entirely. Leave "false" for development.
LOGGER_DISABLED="false"
LOGGER_LOG_PREVIOUS_CALLER_SOURCE_DISABLED="false"


############################
### AI ASSISTANT CHANNEL ###
############################
# Optional - only needed if you use Vertix's AI assistant feature. The bot will
# listen in the configured guild/channel and respond using the OpenAI key below.

#AI_CHAT_DISCORD_TOKEN=""
#AI_CHAT_GUILD_ID=""
#AI_CHAT_CHANNEL_ID=""

# OpenAI key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=""
# Defaults to gpt-4o-mini when empty.
OPENAI_CHAT_MODEL=""


########################
### TIMERS / CLEANUP ###
########################

# Adapter cleanup intervals (milliseconds).
ADAPTER_CLEANUP_TIMER_INTERVAL=300000
ADAPTER_CLEANUP_EPHEMERAL_TIMEOUT=600000
ADAPTER_CLEANUP_STATIC_ARGS_TIMEOUT=600000

# Dynamic Channel Vote manager.
DYNAMIC_CHANNEL_VOTE_TIMEOUT=60000
DYNAMIC_CHANNEL_VOTE_ADD_TIME=60000
DYNAMIC_CHANNEL_VOTE_TIMER_INTERVAL=1000

# Dynamic Channel Claim manager.
DYNAMIC_CHANNEL_CLAIM_OWNERSHIP_TIMEOUT=600000
DYNAMIC_CHANNEL_CLAIM_OWNERSHIP_TIMER_INTERVAL=60000


##############
### TOP.GG ###
##############
# Optional - only needed if you list your bot on top.gg.

TOP_GG_VOTE_URL="https://top.gg/"
#TOP_GG_TOKEN=""


#############
### DEBUG ###
#############
# All DEBUG_* variables only emit output when LOGGER_LOG_LEVEL=6.
# Leave them empty / commented to keep logs clean. Set them to a newline-
# separated list of namespaces to enable verbose tracing in that area.

#DEBUG_PRISMA="true"

# Debug of models.
#DEBUG_MODEL="
#VertixBase/Models/User
#VertixBase/Models/Channel
#VertixBase/Models/Config
