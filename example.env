# ---------------------------------------------------------------------------
# End-to-end tests (packages/vertix-bot-e2e)
#
# The suite deletes every generator in the guild it runs against before each
# test, so the guild is stated twice: once as where to run, once as where that
# is allowed. They have to match or nothing starts.
# ---------------------------------------------------------------------------
E2E_DISCORD_GUILD_ID=
E2E_DISCORD_DESTRUCTIVE_GUILD_ID=

# The application name discord shows beside each row in the slash-command
# autocomplete. A guild with other voice-channel bots in it offers several
# identical commands, and this is what tells them apart.
E2E_DISCORD_APP_NAME=

# The text channel commands are typed in.
E2E_DISCORD_COMMAND_CHANNEL_ID=

# Optional: a second member, for the features that act on somebody else.
E2E_DISCORD_SECOND_MEMBER_ID=

# Used to list and delete channels between tests. Falls back to DISCORD_BOT_TOKEN.
E2E_DISCORD_BOT_TOKEN=

# E2E_HEADLESS=0 to watch the run, E2E_SLOW_MOTION_MS to slow it down.
E2E_HEADLESS=1
E2E_SLOW_MOTION_MS=0

# Whether a run may open a window and wait for somebody to sign into discord.
# Off under CI, where nobody is there to do it.
E2E_INTERACTIVE_LOGIN=
E2E_LOGIN_TIMEOUT_MS=300000

# --- Sharding -----------------------------------------------------------------------------------
# Both or neither. Unset, the bot runs every shard in one process and lets discord decide how many,
# which is what it has always done and what every deployment does today.
#
# Set, they split the bot across processes: SHARD_COUNT is the total across the whole bot, and
# SHARD_IDS is the comma separated subset this process runs. Each group is its own pm2 app, one
# process each - deliberately not a ShardingManager spawning children, because pm2 on the box walks
# a process tree with a `pgrep -P` per node and that fan-out has taken the daemon down before.
#
# Whoever holds shard 0 also does the work that belongs to the bot rather than to a shard: the AI
# chat client, and the top.gg server count.
#
#   vertix-bot-0:  SHARD_COUNT=4  SHARD_IDS=0,1
#   vertix-bot-1:  SHARD_COUNT=4  SHARD_IDS=2,3
#
#SHARD_COUNT=""
#SHARD_IDS=""

# --- Interaction trace --------------------------------------------------------------------------
# Every press is timed from the moment discord created it: the database queries it made, the
# discord requests and rate limits it waited on, the screen builds, and any event loop stall that
# held it up. A press slower than VERTIX_TRACE_SLOW_MS is logged as "Slow interaction ..." with that
# breakdown, and every VERTIX_TRACE_SUMMARY_INTERVAL_MS a "Where the time went" summary lists what
# cost the most across all of them. See packages/vertix-base/src/modules/trace/interaction-trace.ts.
#
# On by default; VERTIX_TRACE_DISABLED=true turns it off.
VERTIX_TRACE_DISABLED=false
VERTIX_TRACE_SLOW_MS=1500
VERTIX_TRACE_SUMMARY_INTERVAL_MS=600000

# --- Crash alerting -----------------------------------------------------------------------------
# A discord webhook url. Two different things post to it, and neither says anything without it:
#
#   ErrorAlertService  - every ERROR line any app logs, deduped, with the few lines that came
#                        before it. Lives inside the process, so it reports what a running app
#                        went wrong at.
#   vertix-watchdog    - the pm2 app deaths themselves. Lives outside every app it watches,
#                        because a process cannot report that it has stopped existing.
DISCORD_ERROR_WEBHOOK_URL=""

# How long the same error line stays quiet after being reported, and the ceiling on alerts per
# minute. The counts held back ride along on the next alert rather than being lost.
ERROR_ALERT_DEDUPE_WINDOW_MS=300000
ERROR_ALERT_MAX_PER_MINUTE=5

# --- Watchdog -----------------------------------------------------------------------------------
# pm2 already restarts what crashes. The watchdog is for the two things it does silently: it tells
# nobody, and after `max_restarts` unstable restarts it marks an app `errored` and stops trying.
#
# Falls back to DISCORD_ERROR_WEBHOOK_URL. Set this only to send crash notices somewhere separate
# from the error lines - a channel somebody actually watches, say.
#WATCHDOG_WEBHOOK_URL=""

# Who gets pinged, as discord markup: "<@USER_ID>" or "<@&ROLE_ID>". Only a crash and a give-up
# ping; the watchdog reporting that it handled one does not.
#WATCHDOG_ALERT_MENTION=""

# pm2 apps to say nothing about, comma separated. The watchdog never watches itself.
#WATCHDOG_IGNORED_APPS="pm2-dashboard"

# How often to sweep pm2 for an app sitting `errored` - the state the bus cannot report if the
# watchdog was not running when it happened.
WATCHDOG_RECONCILE_INTERVAL_MS=60000

# Repeated deaths of one app collapse into a single alert within this window.
WATCHDOG_DEDUPE_WINDOW_MS=60000

# How long a deliberate stop is held before it is reported.
#
# At the moment pm2 emits the `exit`, a `pm2 stop` and the first half of a redeploy are the same
# event - the difference is whether the app comes back. So these are held, and whatever went down
# together is reported as one notice once it is clear which happened: "3 apps redeployed", or
# "stopped" for the ones still down. Neither pings. Long enough to cover the ordered restart, which
# waits for each app's port before starting the next.
WATCHDOG_DELIBERATE_SETTLE_MS=90000

# How long to wait before starting back an app pm2 gave up on, and the ceiling that wait doubles
# towards. An app that goes straight back to errored is broken rather than unlucky, so starting it
# every thirty seconds would turn one outage into a channel full of alerts.
WATCHDOG_REVIVE_INITIAL_DELAY_MS=30000
WATCHDOG_REVIVE_MAX_DELAY_MS=900000
