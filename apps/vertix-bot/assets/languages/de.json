  "embeds": [
    {
      "name": "VertixBot/UI-General/DisabledWhileClaimEmbed",
      "content": {
        "title": "😈 Die Aktion ist deaktiviert",
        "description": "Die Aktion ist deaktiviert, während der Anspruch läuft.\n\nBitte warte, bis der Anspruch abgeschlossen ist."
      }
    },
    {
      "name": "VertixBot/UI-General/InvalidChannelTypeEmbed",
      "content": {
        "title": "# Hoppla! Diese Komponente ist in diesem Kanaltyp eingeschränkt.",
        "description": "Die Aktion ist in diesem Kanaltyp eingeschränkt, aber die verfügbaren Kanaltypen sind:\n\n{allowedTypes}\n\nBitte versuche die Aktion in einem anderen Kanal.",
        "arrayOptions": {
          "allowedTypes": {
            "format": "- {value}{separator}",
            "separator": "\n"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/LanguageEmbed",
      "content": {
        "title": "🌍  Sprache auswählen",
        "description": "__Aktuell ausgewählte Sprache__: **{currentLanguage}**\n\nHast du deine Sprache nicht gefunden?\n\nDu kannst derjenige sein, der den Bot in deine Sprache übersetzt!\nKontaktiere uns auf unserem Support-Server und werde Übersetzer!\n\nHast du einen Übersetzungsfehler gefunden? Bitte lass es uns wissen!",
        "options": {
          "currentLanguage": {
            "en": "Englisch",
            "ru": "Russisch",
            "el": "Griechisch",
            "es": "Spanisch",
            "fr": "Französisch",
            "de": "Deutsch",
            "ja": "Japanisch"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/MissingPermissionsEmbed",
      "content": {
        "title": "🔐  Hoppla! Bestimmte Berechtigungen sind erforderlich",
        "description": "Einige Berechtigungen sind erforderlich, um fortzufahren. **{omitterDisplayName}** fehlen die folgenden Berechtigungen:\n\n{missingPermissions}",
        "arrayOptions": {
          "missingPermissions": {
            "format": "- {value}{separator}",
            "separator": "\n"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/NothingChangedEmbed",
      "content": {
        "title": "🤷  Nichts geändert",
        "description": "Dies kann auftreten, wenn du versuchst, etwas zu ändern, das nicht geändert werden kann oder gleich wie vorher ist."
      }
    },
    {
      "name": "VertixBot/UI-General/NotYourChannelEmbed",
      "content": {
        "title": "⛔  Das ist nicht dein Kanal!",
        "description": "Aber du kannst deinen eigenen Kanal öffnen :)\n\nKlicke einfach hier: <#{masterChannelId}>"
      }
    },
    {
      "name": "VertixBot/UI-General/SetupEmbed",
      "content": {
        "title": "🛠  VoiceChannels einrichten",
        "description": "Entdecke die grenzenlosen Möglichkeiten von **VoiceChannels**!\nPasse deinen Server perfekt an und optimiere ihn.\n\nUm einen neuen Masterkanal zu erstellen, klicke einfach auf:\ndie Schaltfläche `(➕ Masterkanal erstellen)`.\n\nMasterkanäle sind Generatoren für dynamische Sprachkanäle, jeder mit seiner eigenen einzigartigen Konfiguration.\n\nUnsere Funktion für verbotene Wörter ermöglicht eine Konfiguration auf Serverebene zur Begrenzung der Namen dynamischer Kanäle.\n\n_**Aktuelle Masterkanäle**_:\n{masterChannelMessage}\n\n_Aktuelle verbotene Wörter_:\n{badwordsMessage}\n\n-# 💡 Du kannst einen Log-Kanal festlegen, indem du den Masterkanal bearbeitest.\n",
        "options": {
          "masterChannelMessage": {
            "{masterChannels}": "\n{masterChannels}",
            "{masterChannelMessageDefault}": "**Keine**"
          },
          "badwordsMessage": {
            "{badwords}": "`{badwords}`",
            "{badwordsMessageDefault}": "**Keine**"
          },
          "none": "**Keine**"
        },
        "arrayOptions": {
          "masterChannels": {
            "format": "{value}{separator}",
            "separator": "\n",
            "multiSeparator": "\n\n",
            "options": {
              "index": "**#{index}**",
              "name": "▹ Name: <#{id}>",
              "id": "▹ Kanal-ID: `{id}`",
              "channelsTemplateName": "▹ Name der dynamischen Kanäle: `{channelsTemplateName}`",
              "channelsTemplateButtons": "▹ Schaltflächen: **{channelsTemplateButtons}**",
              "channelsVerifiedRoles": "▹ Verifizierte Rollen: {channelsVerifiedRoles}",
              "channelsLogsChannelId": "▹ Log-Kanal: {channelsLogsChannelId}",
              "channelsAutoSave": "▹ Automatische Speicherung: `{channelsAutoSave}`",
              "version": "▹ UI-Version: `{version}`"
            }
          },
          "badwords": {
            "format": "{value}{separator}",
            "separator": ", "
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/SetupMaxMasterChannelsEmbed",
      "content": {
        "title": "🤷  Du hast das Limit für Masterkanäle erreicht",
        "description": "Du kannst insgesamt bis zu **{maxMasterChannels}** Masterkanäle erstellen."
      }
    },
    {
