  "embeds": [
    {
      "name": "VertixBot/UI-General/DisabledWhileClaimEmbed",
      "content": {
        "title": "😈 アクションは無効です",
        "description": "取得処理中はアクションが無効です。\n\n取得が完了するまでお待ちください。"
      }
    },
    {
      "name": "VertixBot/UI-General/InvalidChannelTypeEmbed",
      "content": {
        "title": "# おっと！このコンポーネントはこのチャンネルタイプでは制限されています。",
        "description": "このチャンネルタイプではアクションが制限されていますが、利用可能なチャンネルタイプは：\n\n{allowedTypes}\n\n別のチャンネルでアクションを再試行してください。",
        "arrayOptions": {
          "allowedTypes": {
            "format": "- {value}{separator}",
            "separator": "\n"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/LanguageEmbed",
      "content": {
        "title": "🌍  言語を選択",
        "description": "__現在選択されている言語__：**{currentLanguage}**\n\nお探しの言語が見つかりませんでしたか？\n\nあなたの言語にボットを翻訳する人になれます！\nサポートサーバーでお問い合わせください！\n\n翻訳の間違いを見つけましたか？お知らせください！",
        "options": {
          "currentLanguage": {
            "en": "英語",
            "ru": "ロシア語",
            "el": "ギリシャ語",
            "es": "スペイン語",
            "fr": "フランス語",
            "de": "ドイツ語",
            "ja": "日本語"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/MissingPermissionsEmbed",
      "content": {
        "title": "🔐  おっと！特定の権限が必要です",
        "description": "続行するには権限が必要です。**{omitterDisplayName}**には以下の権限がありません：\n\n{missingPermissions}",
        "arrayOptions": {
          "missingPermissions": {
            "format": "- {value}{separator}",
            "separator": "\n"
          }
        }
      }
    },
    {
      "name": "VertixBot/UI-General/NothingChangedEmbed",
      "content": {
        "title": "🤷  変更なし",
        "description": "変更できないものを変更しようとした場合、または以前と同じ場合に発生する可能性があります。"
      }
    },
    {
      "name": "VertixBot/UI-General/NotYourChannelEmbed",
      "content": {
        "title": "⛔  これはあなたのチャンネルではありません！",
        "description": "でも自分のチャンネルを開くことができます :)\n\nここをクリック：<#{masterChannelId}>"
      }
    },
    {
      "name": "VertixBot/UI-General/SetupEmbed",
      "content": {
        "title": "🛠   VoiceChannels をセットアップ",
        "description": "**VoiceChannels**の無限の可能性を発見しましょう！\nサーバーを完璧にカスタマイズして最適化しましょう。\n\n新しいマスターチャンネルを作成するには：\n`(➕ マスターチャンネルを作成)`ボタンをクリックしてください。\n\nマスターチャンネルは、それぞれ独自の設定を持つダイナミックボイスチャンネルジェネレーターです。\n\n禁止ワード機能により、サーバーレベルでダイナミックチャンネル名を制限する設定が可能です。\n\n_**現在のマスターチャンネル**_：\n{masterChannelMessage}\n\n_現在の禁止ワード_：\n{badwordsMessage}\n\n-# 💡 マスターチャンネルを編集することでログチャンネルを設定できます。\n",
        "options": {
          "masterChannelMessage": {
            "{masterChannels}": "\n{masterChannels}",
            "{masterChannelMessageDefault}": "**なし**"
          },
          "badwordsMessage": {
            "{badwords}": "`{badwords}`",
            "{badwordsMessageDefault}": "**なし**"
          },
          "none": "**なし**"
        },
        "arrayOptions": {
          "masterChannels": {
            "format": "{value}{separator}",
            "separator": "\n",
            "multiSeparator": "\n\n",
            "options": {
