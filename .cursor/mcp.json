{
    "mcpServers": {
      "browser-tools-mcp-server": {
        "id": "browser-tools-mcp",
        "name": "Browser Tools MCP",
        "command": "npx",
        "args": ["@agentdeskai/browser-tools-mcp@latest"],
        "enabled": true
      },
      "vertix-logger": {
        "command": "bun",
        "args": [
          "run",
          "/Users/inewlegend/Desktop/dev/vertix.gg/packages/vertix-logger/src/mcp-stdio.ts"
        ],
        "env": {
          "LOGGER_SERVER_HTTP_PORT": "3090",
          "LOGGER_SERVER_HOST": "localhost"
        }
      },
      "MCP Installer": {
        "command": "npx",
        "type": "stdio",
        "args": [
          "cursor-mcp-installer-free@0.1.3",
          "index.mjs"
        ]
      }
    }
  }