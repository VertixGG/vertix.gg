generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "linux-arm64-openssl-3.0.x"]
  output        = "../src/prisma-bot-client"
}

datasource db {
  provider = "mongodb"
  url      = env("BOT_PRISMA_DATABASE_URL")
}

enum E_INTERNAL_CHANNEL_TYPES {
  DEFAULT_CHANNEL
  DYNAMIC_CHANNEL
  MASTER_CREATE_CHANNEL
  MASTER_SCALING_CHANNEL
  SCALING_CHANNEL
}

enum E_DATA_TYPES {
  string
  number
  boolean
  object
  array
}

// Bot configuration.

model Config {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  key       String
  version   String
  type      E_DATA_TYPES @default(string)
  // ---
  object    Json?
  value     String?
  values    String[]
  // ---
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // ---
  @@unique([key, version])
}

model Category {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  name             String
  categoryId       String
  guildId          String
  // ---
  createdAtDiscord Int
  // ---
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([categoryId])
  @@index([guildId])
}

model Guild {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId           String      @unique
  name              String
  // ---
  isInGuild         Boolean
  // ---
  data              GuildData[] @relation("GuildData")
  // ---
  lastActiveAt      DateTime?   @default(now())
  // ---
  /// When the bot last joined - `createdAt` is the first time it ever did, and a server that removes
  /// the bot and adds it again is a new install worth counting from its own start.
  joinedAt          DateTime?
  /// When the bot last left, or null while it is in.
  leftAt            DateTime?
  /// The first generator of either kind, ever. Kept through leaving and coming back: it answers
  /// "did this server ever set the bot up", not "is it set up now" - the channel rows answer that.
  setupAt           DateTime?
  /// The first room a member made from a generator, ever.
  firstRoomAt       DateTime?
  /// When the server's free trial of the paid plan runs out - written once, from a room a member
  /// made, and never moved again. The end rather than the start, so changing how long a trial
  /// lasts reaches new trials only, never one already given.
  trialEndsAt       DateTime?
  /// When the owner was told the trial is about to run out - written once, by whichever bot claimed
  /// the telling before sending it, so it is said once however many processes are looking.
  trialWarnedAt     DateTime?
  // ---
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  updatedAtInternal DateTime?

  @@index([lastActiveAt])
}

/// Where an install came from - the link somebody pressed to add the bot.
///
/// Written by the api when discord hands the installer back to us, which only happens for links that
/// ask it to; an install from anywhere else has no row, and is reported as unattributed. Kept apart
/// from `Guild` because it arrives from a different process, in no set order against the bot's own
/// join, and a server can be installed more than once.
///
/// Only written once the code discord sent back has been exchanged for the server it went into, so
/// every row is a real install - the callback is public, and a guild id in a query string is not.
model GuildInstall {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId     String
  /// A literal from `TInstallSource`.
  source      String
  /// The permissions granted, as discord's redirect reports them - a server can untick some.
  permissions String?

  // ---
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([createdAt])
}

/// How many rooms a server's members made on one day - UTC.
///
/// A count, not a record of anybody: no member, no channel, only how much the bot was used there,
/// which is the one thing that says whether an install turned into a server that runs on it.
model GuildActivityDay {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId      String
  /// Midnight UTC of the day counted.
  day          DateTime
  roomsCreated Int      @default(0)

  // ---
  updatedAt DateTime @updatedAt

  @@unique([guildId, day])
  @@index([day])
}

/// How many rooms a server's members made in one hour - UTC.
///
/// `GuildActivityDay` by the hour, for when in the day and the week the bot is used. A row of its own
/// rather than fields on the day's, so the day stays one count and an hour is one row to add one to.
/// Like the day, a count and nothing more: no member, no channel.
model GuildActivityHour {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId      String
  /// The start of the hour counted, UTC.
  hour         DateTime
  roomsCreated Int      @default(0)

  // ---
  updatedAt DateTime @updatedAt

  @@unique([guildId, hour])
  @@index([hour])
}

model GuildData {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  key       String
  version   String
  type      E_DATA_TYPES @default(string)
  // ---
  object    Json?
  value     String?
  values    String[]
  // ---
  ownerId   String       @db.ObjectId
  guild     Guild        @relation("GuildData", fields: [ownerId], references: [id], onDelete: Cascade)
  // ---
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId, key, version])
}

/// One override target: a component, optionally narrowed to a generator, a state and a language.
///
/// A row rather than a key inside a per-guild blob, so the things that identify an override are
/// fields - nothing has to encode them into a string, and a writer cannot disagree with a reader
/// about how that string is spelled.
model GuildCustomization {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  /// The guild the override belongs to; `__default__` is the base layer under every guild.
  guildId          String
  /// The component's own name, as `getName()` returns it - "VertixBot/UI-V3/DynamicChannel".
  /// Never shortened: `UI-V2/DynamicChannel` and `UI-V3/DynamicChannel` are different components.
  component        String
  /// The state the override is narrowed to, or null for every state of the component.
  state            String?
  /// The language the override is narrowed to, or null for every language.
  language         String?
  /// The generator whose channels the override is narrowed to, or null for the whole guild.
  /// A guild runs several generators and words them differently, so the guild is not always the
  /// right thing to say an override about.
  masterChannelId  String?
  // ---
  embedOverrides   Json?
  elementOverrides Json?
  modalOverrides   Json?
  variables        Json?
  // ---
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, masterChannelId, component, state, language])
  @@index([guildId, component])
}

model Channel {
  id               String                   @id @default(auto()) @map("_id") @db.ObjectId
  channelId        String                   @unique
  // ---
  guildId          String
  userOwnerId      String
  // ---
  categoryId       String?
  ownerChannelId   String?
  // ---
  version          String                   @default("0.0.0.0")
  data             ChannelData[]            @relation("ChannelData")
  userChannelData  UserChannelData[]        @relation("ChannelUserChannelData")
  // ---
  internalType     E_INTERNAL_CHANNEL_TYPES @default(DEFAULT_CHANNEL)
  // ---
  createdAtDiscord Int
  // ---
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([guildId])
  @@index([categoryId])
  @@index([userOwnerId])
}

model ChannelData {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  key       String
  version   String
  type      E_DATA_TYPES @default(string)
  // ---
  object    Json?
  value     String?
  values    String[]
  // ---
  ownerId   String       @db.ObjectId
  channel   Channel      @relation("ChannelData", fields: [ownerId], references: [id], onDelete: Cascade)
  // ---
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId, key, version])
}

model User {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  userId      String            @unique
  username    String?
  // ---
  data        UserData[]        @relation("UserData")
  channelData UserChannelData[] @relation("UserChannelData")
  // ---
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model UserData {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  key       String
  version   String
  type      E_DATA_TYPES @default(string)
  // ---
  object    Json?
  value     String?
  values    String[]
  // ---
  ownerId   String       @db.ObjectId
  user      User         @relation("UserData", fields: [ownerId], references: [id], onDelete: Cascade)
  // ---
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId, key, version])
  @@index([key])
  @@index([ownerId])
}

/// One member's settings for one generator.
///
/// Hangs off both sides: the member who chose the settings, and the generator they apply to. Only
/// the member was a relation, so a generator going away left its rows behind with nothing that
/// would ever read or reap them - `channelId` pointed at a `Channel` that no longer existed. The
/// second relation is what makes the row go when either end does.
model UserChannelData {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  channelId String       @db.ObjectId
  channel   Channel      @relation("ChannelUserChannelData", fields: [channelId], references: [id], onDelete: Cascade)
  // ---
  key       String
  version   String
  type      E_DATA_TYPES @default(string)
  // ---
  object    Json?
  value     String?
  values    String[]
  // ---
  ownerId   String       @db.ObjectId
  user      User         @relation("UserChannelData", fields: [ownerId], references: [id], onDelete: Cascade)
  // ----
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId, channelId, key, version])
  @@index([channelId])
  @@index([key])
  @@index([ownerId])
}

/// An extra instruction the AI Chat bot follows in one channel.
///
/// Keyed by the raw Discord channel id rather than hung off `Channel`: that row only
/// exists for channels Vertix itself created, and this has to work in any text channel
/// the bot is talked to in.
///
/// Appended to the base system prompt, never replacing it - a channel can shape how the
/// bot answers, but cannot talk it out of its own instructions.
model AIChannelPrompt {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  channelId    String   @unique
  guildId      String
  // ---
  prompt       String
  // ---
  /// Whether a member joining the guild wakes this channel.
  ///
  /// Off unless asked for: a prompt that only shapes how the bot answers should not also cost an
  /// agent run every time somebody joins.
  onMemberJoin Boolean  @default(false)
  // ---
  /// Who set it, for the admin log - Discord user id.
  updatedBy    String
  // ---
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([guildId])
}

/// A word the AI Chat bot drew into an image and is waiting to hear back.
///
/// Lives here rather than in the MCP server because that process is spawned per agent run and
/// dies with it - the answer has to outlive the turn that posed the question.
///
/// One per person per channel: asking again replaces the old word rather than leaving two
/// answers that would both be accepted.
model AICaptchaChallenge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  channelId String
  userId    String
  guildId   String
  // ---
  /// Normalised to lower case; compared that way, never shown to the model.
  answer    String
  attempts  Int      @default(0)
  // ---
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([expiresAt])
}

/// What a server pays for, as paddle last told us.
///
/// Written only by the webhook and read only by the entitlement service, which is what keeps this
/// from becoming a second opinion about the allowance: paddle is the source of truth and this is
/// the copy the bot can read on a voice join without an http request.
///
/// Keyed by guild rather than by customer. A customer is a person and may pay for several servers;
/// what is sold is an allowance for one server, and that is the question asked on every join.
///
/// `priceId` rather than a tier name, because a tier is this deployment's reading of a price and a
/// name is a thing somebody renames in the paddle dashboard.
model Subscription {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  /// The discord guild this pays for, taken from the checkout's `custom_data`.
  guildId              String    @unique
  // ---
  /// Paddle's own ids, kept so a row can be reconciled against paddle by hand.
  paddleSubscriptionId String    @unique
  paddleCustomerId     String?
  // ---
  /// The price the subscription is billed against - `pri_…`.
  priceId              String
  /// Paddle's own word: active, trialing, past_due, paused or canceled.
  status               String
  // ---
  /// The end of the period already paid for, which is when an allowance stops - whether the
  /// subscription was cancelled, or simply ran out.
  currentPeriodEnd     DateTime?
  /// Set when a cancellation is scheduled but has not happened yet.
  scheduledToCancelAt  DateTime?
  // ---
  /// When paddle says the event that wrote this row happened - not when we received it.
  /// Kept so a delayed event cannot overwrite a newer one that arrived first.
  occurredAt           DateTime?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// The bot profile a server chose for itself - name, avatar, banner and bio, shown in that server only.
///
/// What was asked for, not what is showing: whether it is on the bot right now is `GuildBrandingState`,
/// kept per application, because two bots read this database (see "Running Instances" in AGENTS.md)
/// and each applies a profile to its own member.
///
/// A null field is the bot's own. Removing a profile saves one with every field null, so the bot takes
/// its own name and face back through the same path that set them.
model GuildBranding {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId         String  @unique
  // ---
  nick            String?
  bio             String?
  /// `data:image/…;base64,` - checked on the way in and again before it is handed to discord.
  avatar          String?
  banner          String?
  // ---
  /// Raised on every save, so a bot can tell the profile it applied from one saved since.
  revision        Int     @default(0)
  /// The discord user who last saved it.
  updatedByUserId String?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What one bot has put on its own member in a server, from `GuildBranding`.
///
/// One row per server per application, because the database is shared by two bots and each only ever
/// touches its own - a bot never undoes, or counts as done, what the other one applied.
model GuildBrandingState {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId         String
  applicationId   String
  // ---
  /// The `GuildBranding.revision` on the bot now, or null when nothing of it is.
  appliedRevision Int?
  appliedAt       DateTime?
  /// Whether the name on the bot is one this set, so taking the profile away knows to give it back.
  appliedNick     Boolean   @default(false)
  /// The nickname the bot had before a profile named it - restored when the profile stops naming it.
  previousNick    String?
  /// The name - the profile's, or the one it replaced - still has to be set, and is waiting for the
  /// Change Nickname permission. The rest of the profile is applied.
  nickPending     Boolean   @default(false)
  // ---
  lastError       String?
  lastAttemptAt   DateTime?
  /// A revision discord refused as invalid. A sweep does not push it again - only a new save does -
  /// so a refused profile is not retried every few minutes against the server's cooldown.
  refusedRevision Int?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, applicationId])
  @@index([applicationId])
}

/// What Events does in a server - written from `/setup` -> Events.
///
/// One row per server. `applicationId` is the bot whose setup last saved it: two bots read this
/// database, and only that one posts, so a server holding both is not sent every board twice.
model GuildEventSettings {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  guildId               String    @unique
  applicationId         String
  // ---
  enabled               Boolean   @default(false)
  /// The text channel the boards, the "need a sub" posts and the attendance go to.
  channelId             String?
  subPostsEnabled       Boolean   @default(true)
  // --- Everything below is null until the server sets it - `GUILD_EVENTS_SETTINGS_DEFAULTS` answers until then.
  /// Minutes before the start the board goes up and check-in opens.
  checkInLeadMinutes    Int?
  /// Minutes after the start somebody still counts as on time; the roster locks then.
  lateAfterMinutes      Int?
  /// Minutes the event's channels stay empty, once the roster locked, before the attendance is final.
  endAfterEmptyMinutes  Int?
  /// The longest a run stays open, in hours from the start.
  maxDurationHours      Int?
  /// Only events held in these voice or stage channels - empty for every one.
  eventChannelIds       String[]
  /// The role pinged when check-in opens.
  checkInRoleId         String?
  /// Whether the members on the roster are pinged by name when check-in opens.
  checkInPingInterested Boolean?
  /// The role the "need a sub" post pings.
  subRoleId             String?
  /// The fewest missing it takes for a "need a sub" post to go up.
  subMinMissing         Int?
  /// The least time in voice, in minutes over the whole event, that counts as having come.
  minVoiceMinutes       Int?
  /// A second text channel each finished attendance is copied to.
  logChannelId          String?
  // ---
  /// A `GUILD_EVENTS_ERRORS` code - the last thing that stopped Events here, for the settings screen.
  lastError             String?
  lastErrorAt           DateTime?
  /// The discord user who last changed it.
  updatedByUserId       String?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, enabled])
}

/// One occurrence of a server's scheduled event, as one bot ran it.
///
/// Keyed by the occurrence's start as well as the event, because a recurring event keeps its id and
/// moves its start on to the next occurrence. Per application, like `GuildBrandingState`.
model GuildEventRun {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  applicationId     String
  guildId           String
  scheduledEventId  String
  occurrenceStartAt DateTime
  // ---
  name              String
  voiceChannelId    String
  /// A `GUILD_EVENT_RUN_PHASES` literal.
  phase             String
  // ---
  postChannelId     String
  boardMessageId    String?
  subPostMessageId  String?
  /// How many places the "need a sub" post asked for when it went up.
  subsNeeded        Int       @default(0)
  // ---
  frozenAt          DateTime?
  endedAt           DateTime?
  /// The last sweep that looked at the run - how far a visit is credited when the bot went down
  /// and the member was gone by the time it came back.
  checkpointAt      DateTime?
  /// A `GUILD_EVENTS_ERRORS` code, so what failed is not tried again for the rest of the run.
  lastError         String?
  /// The least time in voice that counted as coming, as the server had it when the run ended - kept
  /// on the run, so changing the setting later does not rewrite an attendance already given.
  minVoiceSeconds   Int?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, scheduledEventId, occurrenceStartAt])
  @@index([applicationId, phase])
  @@index([guildId, occurrenceStartAt])
}

/// One member's part in a run: whether they said they would come, when they came, how long they stayed.
model GuildEventAttendee {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  // ---
  runId            String    @db.ObjectId
  guildId          String
  userId           String
  /// The name the server showed for them - read off the roster or their voice state as the run saw it,
  /// so the attendance can be read back without asking discord who an id was.
  displayName      String?
  // ---
  /// On the event's "Interested" list - as it stood when the roster froze, once it has.
  interested       Boolean   @default(false)
  /// The first time they were in the event's voice channels.
  checkedInAt      DateTime?
  /// On the roster, and came only after it froze.
  late             Boolean   @default(false)
  /// On the roster, and had not come when it froze. Cleared if they come after all.
  noShow           Boolean   @default(false)
  // ---
  /// Time in the event's voice channels over every visit that has ended.
  voiceSeconds     Int       @default(0)
  /// When the visit still going began, or null when they are not there.
  sessionStartedAt DateTime?

  // ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, userId])
  @@index([guildId, userId])
}
