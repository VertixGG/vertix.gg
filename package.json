{
    "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
    "name": "vertix.gg",
    "author": "Leonid Vinikov <leonidvinikov@gmail.com> (https://github.com/iNewLegend)",
    "license": "MIT",
    "type": "module",
    "version": "0.0.0",
    "description": "Vertix - Discord Bot",
    "private": true,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vertixgg/vertix.git"
    },
    "overrides": {
        "@zenflux/tsconfig-to-swc": "0.1.21"
    },
    "workspaces": [
        "packages/*",
        "apps/*",
        "assets"
    ],
    "scripts": {
        "vertix:ai:bun:start:dev": "cd apps/vertix-ai && bun run vertix-ai:bun:start:dev",
        "vertix:ai:bun:start:dev--watch": "cd apps/vertix-ai && bun run vertix-ai:bun:start:dev--watch",
        "vertix:ai:eslint": "bunx --bun eslint apps/vertix-ai",
        "vertix:ai:typecheck": "cd apps/vertix-ai && bun run vertix-ai:typecheck",
        "vertix:api:dev": "cd apps/vertix-api && bun run vertix-api:bun:start:dev",
        "vertix:api:typecheck": "cd apps/vertix-api && bun run vertix-api:typecheck",
        "vertix:base:eslint": "bunx --bun eslint packages/vertix-base",
        "vertix:base:jest": "cd packages/vertix-base ; bun run vertix-base:jest",
        "vertix:base:typecheck": "cd packages/vertix-base && bun run vertix-base:typecheck",
        "vertix:bot:backup:prisma": "bun run --bun scripts/backup-bot-prisma.js",
        "vertix:bot:bun:start:dev": "cd apps/vertix-bot && bun run vertix-bot:bun:start:dev",
        "vertix:bot:eslint": "time bunx --bun eslint apps/vertix-bot",
        "vertix:bot:jest": "cd apps/vertix-bot && bun run vertix-bot:jest",
        "vertix:bot:node:start:dev": "cd apps/vertix-bot && bun run vertix-bot:ts-node:start:dev",
        "vertix:bot:typecheck": "cd apps/vertix-bot && bun run vertix-bot:typecheck",
        "vertix:ci:eslint": "bash scripts/ci-eslint.bash",
        "vertix:ci:jest": "bash scripts/ci-jest.bash",
        "vertix:ci:typecheck": "bash scripts/ci-typecheck.bash",
        "vertix:dashboard:deploy": "cd apps/vertix-dashboard && bun run vertix-dashboard:deploy",
        "vertix:dashboard:dev": "cd apps/vertix-dashboard && bun run vertix-dashboard:dev",
        "vertix:dashboard:typecheck": "cd apps/vertix-dashboard && bun run vertix-dashboard:typecheck",
        "vertix:data:typecheck": "cd packages/vertix-data && bun run vertix-data:typecheck",
        "vertix:definitions:typecheck": "cd packages/vertix-definitions && bun run vertix-definitions:typecheck",
        "vertix:discord-ui:typecheck": "cd packages/vertix-discord-ui && bun run vertix-embed:typecheck",
        "vertix:eslint": "time bunx --bun eslint .",
        "vertix:eslint:fix": "time bunx --bun eslint . --fix",
        "vertix:gui:eslint": "bunx --bun eslint packages/vertix-gui",
        "vertix:gui:jest": "cd packages/vertix-gui && bun run vertix-gui:jest",
        "vertix:gui:typecheck": "cd packages/vertix-gui && bun run vertix-gui:typecheck",
        "vertix:jest": "time ( bun run vertix:base:jest & bun run vertix:bot:jest & bun run vertix:gui:jest )",
        "vertix:languages:check": "bun run --bun scripts/check-languages.js",
        "vertix:logger:dev": "cd packages/vertix-logger && bun run vertix-logger:dev",
        "vertix:logger:start": "cd packages/vertix-logger && bun run vertix-logger:start",
        "vertix:mcp:dev": "cd apps/vertix-mcp && bun run vertix-mcp:start:dev",
        "vertix:mcp:typecheck": "cd apps/vertix-mcp && bun run vertix-mcp:typecheck",
        "vertix:prisma:typecheck": "cd packages/vertix-prisma && bun run vertix-prisma:typecheck",
        "vertix:redis:cli": "cd apps/redis && bun run cli",
        "vertix:redis:logs": "cd apps/redis && bun run logs",
        "vertix:redis:start": "cd apps/redis && bun run start",
        "vertix:redis:stop": "cd apps/redis && bun run stop",
        "vertix:test-utils:typecheck": "cd packages/vertix-test-utils && bun run vertix-test-utils:typecheck",
        "vertix:typecheck": "time ( bun run vertix:ai:typecheck & bun run vertix:api:typecheck & bun run vertix:base:typecheck & bun run vertix:bot:typecheck & bun run vertix:dashboard:typecheck & bun run vertix:data:typecheck & bun run vertix:definitions:typecheck & bun run vertix:discord-ui:typecheck & bun run vertix:gui:typecheck & bun run vertix:mcp:typecheck & bun run vertix:prisma:typecheck & bun run vertix:test-utils:typecheck & bun run vertix:ui:typecheck & bun run vertix:utils:typecheck & bun run vertix:website:typecheck )",
        "vertix:ui:typecheck": "cd packages/vertix-ui && bun run vertix-ui:typecheck",
        "vertix:utils:eslint": "time bunx --bun eslint packages/vertix-utils",
        "vertix:utils:typecheck": "cd packages/vertix-utils && bun run vertix-utils:typecheck",
        "vertix:website:build": "cd apps/vertix-website && bun run vertix-website:build",
        "vertix:website:deploy": "cd apps/vertix-website && bun run vertix-website:deploy",
        "vertix:website:dev": "cd apps/vertix-website && bun run vertix-website:dev",
        "vertix:website:eslint": "bunx --bun eslint apps/vertix-website",
        "vertix:website:preview": "cd apps/vertix-website && bun run vertix-website:preview",
        "vertix:website:release": "cd apps/vertix-website && bun run vertix-website:release",
        "vertix:website:typecheck": "cd apps/vertix-website && bun run vertix-website:typecheck"
    },
    "dependencies": {
        "@vertix.gg/api": "workspace:*",
        "@vertix.gg/assets": "workspace:*",
        "@vertix.gg/base": "workspace:*",
        "@vertix.gg/bot": "workspace:*",
        "@vertix.gg/dashboard": "workspace:*",
        "@vertix.gg/data": "workspace:*",
        "@vertix.gg/definitions": "workspace:*",
        "@vertix.gg/discord-ui": "workspace:*",
        "@vertix.gg/gui": "workspace:*",
        "@vertix.gg/mcp": "workspace:*",
        "@vertix.gg/prisma": "workspace:*",
        "@vertix.gg/test-utils": "workspace:*",
        "@vertix.gg/ui": "workspace:*",
        "@vertix.gg/utils": "workspace:*",
        "@vertix.gg/website": "workspace:*"
    },
    "devDependencies": {
        "@jest/globals": "^30.5.1",
        "@jest/types": "^30.5.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@swc/jest": "latest",
        "@types/bun": "latest",
        "@types/jest": "latest",
        "@types/jest-when": "latest",
        "@types/node": "latest",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@zenflux/eslint": "latest",
        "@zenflux/jest": "latest",
        "@zenflux/tsconfig-to-swc": "0.1.21",
        "bun": "latest",
        "bun-types": "latest",
        "cross-env": "^7.0.3",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-react": "^7.37.5",
        "jest": "latest",
        "jest-diff": "^30.5.1",
        "jest-when": "latest",
        "ts-mockito": "latest",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.0"
}
