{
    "extends": "./tsconfig.paths.json",

    "compilerOptions": {
        "incremental": true,

        "rootDir": ".",

        "typeRoots": [
            "../../node_modules/@types",
            "../../node_modules/"
        ],

        "types": [
            "node",
            "bun-types"
        ],

        "target": "ESNext",

        "lib": [
            "ESNext",
            "ES2022",
            "DOM"
        ],

        "module": "ESNext",

        "moduleResolution": "bundler",

        "strict": true,

        "esModuleInterop": true,

        "downlevelIteration": true,

        "skipLibCheck": true,

        "noEmit": true
    }
}
