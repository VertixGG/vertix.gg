{
    // Extends the configuration from "./tsconfig.paths.json"
    "extends": "./tsconfig.paths.json",

    // Compiler options
    "compilerOptions": {
        "incremental": true,
        "typeRoots": [
            "../../node_modules/@types",
        ],
        "types": [
            "node",
        ],
        "target": "ESNext",

        "lib": [
            "ESNext",
            "ES2022"
        ],

        "module": "ESNext",

        "moduleResolution": "bundler",

        "strict": true,

        "esModuleInterop": true,

        "downlevelIteration": true,

        "skipLibCheck": true
    }
}
